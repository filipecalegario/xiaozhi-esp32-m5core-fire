# Board type: M5Stack Core Fire
CONFIG_BOARD_TYPE_M5STACK_CORE_FIRE=y

# Language: English
CONFIG_LANGUAGE_EN_US=y

# M5Stack Core Fire 2018.2A: 16MB Flash, 4MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
# Disable task watchdog (audio processing can be CPU intensive)
CONFIG_ESP_TASK_WDT_INIT=n

# ADC Mic task core affinity (0 or 1, -1 causes assertion failure)
CONFIG_ADC_MIC_TASK_CORE=1

# PSRAM Configuration for M5Stack Core Fire 2018 (4MB PSRAM)
# Required for WiFi and audio buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Increase main task stack for WiFi
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase system event task stack for WiFi (default 2304 is too small)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Disable brownout detector (USB power can be unstable)
CONFIG_ESP_BROWNOUT_DET=n
